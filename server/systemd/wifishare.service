[Unit]
Description=WifiShare HTTPS receiver
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/WifiShare/server
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/wifishare/server.env
ExecStart=%h/WifiShare/server/serve
Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
