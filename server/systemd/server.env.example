# Optional user overrides for systemd/wifishare.service.
# Copy to ~/.config/wifishare/server.env and edit paths.

LAN_SECURE_SHARE_CONFIG=/path/to/WifiShare/server/state/config.json
LAN_SECURE_SHARE_DOWNLOAD_DIR=/path/to/Downloads/WifiShare
LAN_SECURE_SHARE_PHONE_QUEUE_DIR=/path/to/WifiShare/server/state/phone-outbox
