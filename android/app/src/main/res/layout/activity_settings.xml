<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsScroll"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls">

    <LinearLayout
        android:id="@+id/settingsContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="18dp"
        android:paddingTop="4dp"
        android:paddingEnd="18dp"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/backButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/back_to_transfer"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_arrow_back" />

            <TextView
                android:id="@+id/settingsTitleText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:ellipsize="end"
                android:fontFamily="sans-serif-medium"
                android:gravity="center"
                android:maxLines="1"
                android:text="@string/settings_title"
                android:textColor="@color/lss_ink"
                android:textSize="18sp" />

            <ImageButton
                android:id="@+id/settingsActionButton"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@android:color/transparent"
                android:contentDescription="@string/new_server"
                android:padding="13dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_add" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/settingsOverviewPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/savedServersLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="18dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:tag="muted"
                android:text="@string/settings_section_saved_servers"
                android:textColor="@color/lss_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/savedServersList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_surface"
                android:orientation="vertical" />

            <TextView
                android:id="@+id/generalLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:tag="muted"
                android:text="@string/settings_section_general"
                android:textColor="@color/lss_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/generalSettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_surface"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/languageRow"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/languageIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_language" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/settings_section_language"
                        android:textColor="@color/lss_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/languageValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="muted"
                        android:text="@string/language_follow_system"
                        android:textColor="@color/lss_muted"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="59dp"
                    android:background="@color/lss_line" />

                <LinearLayout
                    android:id="@+id/themeRow"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp">

                    <ImageView
                        android:id="@+id/themeIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_theme_system" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/theme_title"
                        android:textColor="@color/lss_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:id="@+id/themeValueText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:tag="muted"
                        android:text="@string/theme_system"
                        android:textColor="@color/lss_muted"
                        android:textSize="12sp" />

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginStart="59dp"
                    android:background="@color/lss_line" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="14dp">

                    <ImageView
                        android:id="@+id/saveLocationIcon"
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:contentDescription="@null"
                        android:padding="8dp"
                        android:src="@drawable/ic_folder" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/save_location"
                        android:textColor="@color/lss_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:ellipsize="middle"
                        android:maxLines="1"
                        android:tag="muted"
                        android:text="@string/download_folder"
                        android:textColor="@color/lss_muted"
                        android:textSize="12sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/appearanceLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="24dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:tag="muted"
                android:text="@string/widget_section"
                android:textColor="@color/lss_muted"
                android:textSize="12sp" />

            <LinearLayout
                android:id="@+id/widgetSettingsGroup"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:background="@drawable/card_surface"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="12dp"
                android:paddingEnd="14dp">

                <ImageView
                    android:id="@+id/widgetAppearanceIcon"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:contentDescription="@null"
                    android:padding="8dp"
                    android:src="@drawable/ic_widgets" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="11dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/widget_appearance"
                        android:textColor="@color/lss_ink"
                        android:textSize="14sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:tag="muted"
                        android:text="@string/widget_follows_app"
                        android:textColor="@color/lss_muted"
                        android:textSize="11sp" />
                </LinearLayout>
            </LinearLayout>

            <TextView
                android:id="@+id/overviewStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:maxLines="3"
                android:tag="muted"
                android:textColor="@color/lss_muted"
                android:textSize="12sp"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/languagePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:visibility="gone">

            <RadioGroup
                android:id="@+id/languageOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingTop="4dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <RadioButton
                    android:id="@+id/languageSystem"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/language_follow_system"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/languageChinese"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/language_simplified_chinese"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/languageEnglish"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/language_english"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/themePanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="@drawable/card_surface"
            android:orientation="vertical"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/themeSystemStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingTop="10dp"
                android:paddingEnd="16dp"
                android:paddingBottom="4dp"
                android:tag="muted"
                android:text="@string/theme_system_current_preview"
                android:textColor="@color/lss_muted"
                android:textSize="11sp" />

            <RadioGroup
                android:id="@+id/themeOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingBottom="4dp">

                <RadioButton
                    android:id="@+id/themeSystem"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/theme_system_option"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/themeLight"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/theme_light_option"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/themeDark"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="@string/theme_dark_option"
                    android:textSize="14sp" />
            </RadioGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/editorPanel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginBottom="7dp"
                android:tag="muted"
                android:text="@string/server_name_label"
                android:textColor="@color/lss_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/serverNameInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_surface"
                android:hint="@string/server_name_hint"
                android:importantForAutofill="no"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/lss_ink"
                android:textColorHint="@color/lss_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="7dp"
                android:tag="muted"
                android:text="@string/server_address_label"
                android:textColor="@color/lss_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/baseUrlInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_surface"
                android:hint="@string/base_url_hint"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:maxLines="1"
                android:textColor="@color/lss_ink"
                android:textColorHint="@color/lss_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="7dp"
                android:tag="muted"
                android:text="@string/server_token_label"
                android:textColor="@color/lss_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/authTokenInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_surface"
                android:hint="@string/auth_token_hint"
                android:importantForAutofill="no"
                android:inputType="textPassword"
                android:maxLines="1"
                android:textColor="@color/lss_ink"
                android:textColorHint="@color/lss_muted"
                android:textSize="14sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="7dp"
                android:tag="muted"
                android:text="@string/server_certificate_label"
                android:textColor="@color/lss_muted"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/fingerprintInput"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/input_surface"
                android:hint="@string/fingerprint_hint"
                android:importantForAutofill="no"
                android:inputType="textVisiblePassword"
                android:maxLines="1"
                android:textColor="@color/lss_ink"
                android:textColorHint="@color/lss_muted"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/editorStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:maxLines="4"
                android:tag="muted"
                android:text="@string/settings_hint"
                android:textColor="@color/lss_muted"
                android:textSize="12sp" />

            <Button
                android:id="@+id/deleteServerButton"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="20dp"
                android:background="@android:color/transparent"
                android:drawableStart="@drawable/ic_delete"
                android:drawablePadding="8dp"
                android:fontFamily="sans-serif-medium"
                android:minWidth="0dp"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:text="@string/delete_server"
                android:textAllCaps="false"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
