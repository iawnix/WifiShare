<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <ScrollView
        android:id="@+id/mainScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/mainContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="4dp"
            android:paddingEnd="18dp"
            android:paddingBottom="18dp">

            <LinearLayout
                android:id="@+id/homePanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/homeContextDot"
                        android:layout_width="7dp"
                        android:layout_height="7dp"
                        android:background="@drawable/status_dot" />

                    <TextView
                        android:id="@+id/homeContextStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="12dp"
                        android:layout_weight="1"
                        android:ellipsize="middle"
                        android:fontFamily="sans-serif-medium"
                        android:maxLines="1"
                        android:tag="muted"
                        android:text="@string/local_network"
                        android:textColor="@color/lss_muted"
                        android:textSize="13sp" />

                    <ImageButton
                        android:id="@+id/settingsButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/settings"
                        android:padding="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_settings" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/settings_section_saved_servers"
                        android:textColor="@color/lss_ink"
                        android:textSize="20sp" />

                    <TextView
                        android:id="@+id/serverCountPill"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:minWidth="26dp"
                        android:textSize="11sp"
                        tools:text="3" />

                    <Space
                        android:layout_width="0dp"
                        android:layout_height="1dp"
                        android:layout_weight="1" />

                    <ImageButton
                        android:id="@+id/manageServersButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/manage_devices"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <HorizontalScrollView
                    android:id="@+id/serverRailScroll"
                    android:layout_width="match_parent"
                    android:layout_height="94dp"
                    android:clipToPadding="false"
                    android:fillViewport="false"
                    android:overScrollMode="never"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/serverRail"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="0dp"
                        android:paddingEnd="18dp" />
                </HorizontalScrollView>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="12dp"
                    android:background="@color/lss_line" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp"
                    android:accessibilityHeading="true"
                    android:fontFamily="sans-serif-medium"
                    android:text="@string/recent_transfers"
                    android:textColor="@color/lss_ink"
                    android:textSize="18sp" />

                <LinearLayout
                    android:id="@+id/recentTransfersList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical">

                    <LinearLayout
                        android:id="@+id/recentEmptyState"
                        android:layout_width="match_parent"
                        android:layout_height="62dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingEnd="13dp">

                        <ImageView
                            android:id="@+id/recentEmptyIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/icon_button_surface"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_file" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:tag="muted"
                            android:text="@string/no_recent_transfers"
                            android:textColor="@color/lss_muted"
                            android:textSize="13sp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/receiveStatusPanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="64dp"
                        android:orientation="horizontal"
                        android:paddingStart="13dp"
                        android:paddingTop="9dp"
                        android:paddingEnd="13dp"
                        android:paddingBottom="9dp"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/receiveStatusIcon"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:background="@drawable/icon_button_surface"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_download" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/homeStatusText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="2"
                                android:textColor="@color/lss_ink"
                                android:textSize="13sp" />

                            <ProgressBar
                                android:id="@+id/receiveProgress"
                                style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
                                android:layout_width="match_parent"
                                android:layout_height="3dp"
                                android:layout_marginTop="7dp"
                                android:indeterminate="true"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/recentHistoryItems"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/draftPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageButton
                        android:id="@+id/clearDraftButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/cancel_pending_share"
                        android:padding="13dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_arrow_back" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/prepare_send_title"
                        android:textColor="@color/lss_ink"
                        android:textSize="18sp" />

                    <Space
                        android:layout_width="48dp"
                        android:layout_height="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/draftDestination"
                    android:layout_width="match_parent"
                    android:layout_height="66dp"
                    android:layout_marginTop="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="12dp"
                    android:paddingEnd="8dp">

                    <ImageView
                        android:id="@+id/draftDestinationIcon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_desktop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:tag="muted"
                            android:text="@string/send_to"
                            android:textColor="@color/lss_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/draftDestinationName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/receiver_missing"
                            android:textColor="@color/lss_ink"
                            android:textSize="15sp" />
                    </LinearLayout>

                    <ImageButton
                        android:id="@+id/changeServerButton"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="@android:color/transparent"
                        android:contentDescription="@string/change_server"
                        android:padding="15dp"
                        android:scaleType="fitCenter"
                        android:src="@drawable/ic_chevron_right" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="3dp"
                    android:paddingEnd="3dp">

                    <TextView
                        android:id="@+id/pendingCountText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/no_pending_share"
                        android:textColor="@color/lss_ink"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/pendingTotalText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:tag="muted"
                        android:textColor="@color/lss_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/pendingItemsList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/draftStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:gravity="center"
                    android:maxLines="3"
                    android:tag="muted"
                    android:textColor="@color/lss_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/sendButton"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="24dp"
                    android:drawableStart="@drawable/ic_upload"
                    android:drawablePadding="9dp"
                    android:ellipsize="end"
                    android:fontFamily="sans-serif-medium"
                    android:gravity="center"
                    android:maxLines="1"
                    android:minWidth="0dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/send_now"
                    android:textAllCaps="false"
                    android:textSize="14sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/uploadPanel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <Space
                        android:layout_width="48dp"
                        android:layout_height="1dp" />

                    <TextView
                        android:id="@+id/uploadScreenTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:accessibilityHeading="true"
                        android:fontFamily="sans-serif-medium"
                        android:gravity="center"
                        android:text="@string/upload_title"
                        android:textColor="@color/lss_ink"
                        android:textSize="18sp" />

                    <Space
                        android:layout_width="48dp"
                        android:layout_height="1dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="5dp"
                    android:paddingEnd="5dp">

                    <ImageView
                        android:id="@+id/uploadDestinationIcon"
                        android:layout_width="38dp"
                        android:layout_height="38dp"
                        android:contentDescription="@null"
                        android:padding="9dp"
                        android:src="@drawable/ic_desktop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/uploadConnectionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:tag="muted"
                            android:text="@string/upload_connected"
                            android:textColor="@color/lss_muted"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/uploadDestinationName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/receiver_missing"
                            android:textColor="@color/lss_ink"
                            android:textSize="15sp" />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="4dp"
                    android:background="@color/lss_line" />

                <LinearLayout
                    android:id="@+id/uploadProgressCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="22dp"
                    android:background="@drawable/card_surface"
                    android:orientation="vertical"
                    android:paddingStart="15dp"
                    android:paddingTop="15dp"
                    android:paddingEnd="15dp"
                    android:paddingBottom="15dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:id="@+id/uploadFileIcon"
                            android:layout_width="38dp"
                            android:layout_height="38dp"
                            android:background="@drawable/icon_button_surface"
                            android:contentDescription="@null"
                            android:padding="9dp"
                            android:src="@drawable/ic_file" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="11dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/uploadItemName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="middle"
                                android:fontFamily="sans-serif-medium"
                                android:maxLines="1"
                                android:text="@string/upload_current_file_unknown"
                                android:textColor="@color/lss_ink"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/uploadItemPosition"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:tag="muted"
                                android:textColor="@color/lss_muted"
                                android:textSize="11sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/uploadPercentText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/lss_ink"
                            android:textSize="14sp"
                            tools:text="68%" />
                    </LinearLayout>

                    <ProgressBar
                        android:id="@+id/uploadProgress"
                        style="@android:style/Widget.DeviceDefault.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="4dp"
                        android:layout_marginTop="15dp"
                        android:indeterminate="true" />

                    <TextView
                        android:id="@+id/uploadByteDetail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="9dp"
                        android:ellipsize="end"
                        android:maxLines="2"
                        android:tag="muted"
                        android:textColor="@color/lss_muted"
                        android:textSize="12sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/uploadMessageText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:gravity="center"
                    android:maxLines="4"
                    android:tag="muted"
                    android:textColor="@color/lss_muted"
                    android:textSize="12sp"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/cancelUploadButton"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="24dp"
                    android:drawableStart="@drawable/ic_stop"
                    android:drawablePadding="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:minWidth="148dp"
                    android:paddingStart="18dp"
                    android:paddingEnd="18dp"
                    android:text="@string/stop_sending"
                    android:textAllCaps="false"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/homeActions"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="6dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="14dp"
        android:background="@drawable/card_surface"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="5dp">

        <Button
            android:id="@+id/selectFilesButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:drawableStart="@drawable/ic_upload"
            android:drawablePadding="9dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/send_now"
            android:textAllCaps="false"
            android:textSize="14sp" />

        <View
            android:layout_width="1dp"
            android:layout_height="30dp"
            android:background="@color/lss_line" />

        <Button
            android:id="@+id/receiveButton"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:contentDescription="@string/widget_receive"
            android:drawableStart="@drawable/ic_download"
            android:drawablePadding="9dp"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="1"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="@string/receive_now"
            android:textAllCaps="false"
            android:textSize="14sp" />
    </LinearLayout>
</LinearLayout>
