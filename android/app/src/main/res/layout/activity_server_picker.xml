<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/serverPickerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginStart="18dp"
        android:layout_marginEnd="18dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/serverPickerClose"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/close"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_arrow_back" />

        <TextView
            android:id="@+id/serverPickerTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:accessibilityHeading="true"
            android:ellipsize="end"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:maxLines="1"
            android:text="@string/server_picker_title"
            android:textColor="@color/lss_ink"
            android:textSize="18sp" />

        <ImageButton
            android:id="@+id/serverPickerManage"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@android:color/transparent"
            android:contentDescription="@string/manage_devices"
            android:padding="13dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_settings" />
    </LinearLayout>

    <ScrollView
        android:id="@+id/serverPickerScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls">

        <LinearLayout
            android:id="@+id/serverPickerContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="18dp"
            android:paddingTop="14dp"
            android:paddingEnd="18dp"
            android:paddingBottom="24dp">

            <LinearLayout
                android:id="@+id/widgetPreviewSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginBottom="8dp"
                    android:fontFamily="sans-serif-medium"
                    android:tag="muted"
                    android:text="@string/widget_preview_label"
                    android:textColor="@color/lss_muted"
                    android:textSize="12sp" />

                <LinearLayout
                    android:id="@+id/widgetPreviewCard"
                    android:layout_width="match_parent"
                    android:layout_height="76dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="14dp"
                    android:paddingEnd="12dp">

                    <ImageView
                        android:id="@+id/widgetPreviewDeviceIcon"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:contentDescription="@null"
                        android:padding="10dp"
                        android:src="@drawable/ic_desktop" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="11dp"
                        android:layout_marginEnd="10dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/widgetPreviewServerName"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:fontFamily="sans-serif-medium"
                            android:maxLines="1"
                            android:text="@string/widget_preview_server"
                            android:textColor="@color/lss_ink"
                            android:textSize="15sp" />

                        <TextView
                            android:id="@+id/widgetPreviewServerAddress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:ellipsize="middle"
                            android:maxLines="1"
                            android:tag="muted"
                            android:textColor="@color/lss_muted"
                            android:textSize="11sp"
                            tools:text="192.168.31.29" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/widgetPreviewAction"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:contentDescription="@null"
                        android:padding="14dp"
                        android:src="@drawable/ic_download" />
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="4dp"
                    android:layout_marginTop="10dp"
                    android:layout_marginEnd="4dp"
                    android:tag="muted"
                    android:text="@string/widget_shared_server_note"
                    android:textColor="@color/lss_muted"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/serverPickerListLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="22dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="8dp"
                android:fontFamily="sans-serif-medium"
                android:tag="muted"
                android:text="@string/settings_section_saved_servers"
                android:textColor="@color/lss_muted"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/serverPickerEmpty"
                android:layout_width="match_parent"
                android:layout_height="72dp"
                android:background="@drawable/card_surface"
                android:gravity="center"
                android:tag="muted"
                android:text="@string/no_saved_servers"
                android:textColor="@color/lss_muted"
                android:textSize="13sp"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/serverPickerOptions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_surface"
                android:orientation="vertical" />
        </LinearLayout>
    </ScrollView>

    <Button
        android:id="@+id/serverPickerConfirm"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginStart="18dp"
        android:layout_marginTop="8dp"
        android:layout_marginEnd="18dp"
        android:layout_marginBottom="14dp"
        android:drawableStart="@drawable/ic_check"
        android:drawablePadding="9dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/widget_confirm"
        android:textAllCaps="false"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
